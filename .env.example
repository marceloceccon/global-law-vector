# Copy to .env and adjust. Every value has the default shown.
GLOBAL_LAW_PATH=../global-law
DATABASE_URL=postgresql://utility:utility@127.0.0.1:5432/utility
GLV_SCHEMA=global_law
TEI_URL=http://127.0.0.1:8080
GLV_MODEL=Snowflake/snowflake-arctic-embed-m-v2.0
GLV_DIMS=768
GLV_MAX_TOKENS=8192
GLV_QUERY_PREFIX="query: "
GLV_VECTOR_TYPE=halfvec
GLV_CHUNK_TOKENS=1024
GLV_BATCH_SIZE=32
GLV_WORKERS=4
# GLV_TOKENIZER=/path/to/tokenizer.json   # else fetched from the hub, else heuristic
GLV_SELECTION=selection.toml
# GLV_CACHE_DIR=~/.cache/global-law-vector
